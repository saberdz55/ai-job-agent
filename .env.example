# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# The production Agent runtime uses OpenAI.
JOB_AGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required for the authenticated localhost API/browser extension bridge.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOB_AGENT_TOKEN=

# Persistent data directory
JOB_AGENT_DATA_DIR=data
