# Copy to .env and fill in. The .env file is gitignored — never commit real keys.

# LLM provider: anthropic (default) or openai
JOB_AGENT_PROVIDER=anthropic

# Anthropic provider
ANTHROPIC_API_KEY=
JOB_AGENT_MODEL=claude-haiku-4-5

# OpenAI provider (server-side only; never expose this key in the browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Persistent data directory
JOB_AGENT_DATA_DIR=data
